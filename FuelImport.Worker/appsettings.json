{
  "ConnectionStrings": {
    "FuelImport": "Data Source=fuelimport.db"
  },
  "Import": {
    "RootFolder": "",
    "DryRun": true,
    "Recursive": true,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".heic"
    ]
  },
  "Confidence": {
    "PumpOcrWeight": 0.25,
    "DashOcrWeight": 0.2,
    "ClassificationWeight": 0.15,
    "PairingWeight": 0.15,
    "VehicleWeight": 0.2,
    "ValidationPenaltyPerError": 0.1,
    "ValidationPenaltyPerWarning": 0.03,
    "AutoApproveThreshold": 0.9,
    "ReviewThreshold": 0.7
  },
  "Validation": {
    "MaxMinutesBetweenPumpAndDash": 10,
    "AllowedPriceMismatchAbsolute": 0.35,
    "DefaultMinMilesBetweenEvents": 10,
    "DefaultMaxMilesBetweenEvents": 800
  },
  "AwsVision": {
    "EnableAwsApis": false,
    "Region": "us-east-1",
    "A2iFlowDefinitionArn": ""
  }
}
